{
    "name": "flextree-sqljs-adapter",
    "type": "module",
    "version": "3.2.0",
    "description": "sql.js driver for flextree, run tree in browser via wasm sqlite",
    "author": "zhangfisher",
    "homepage": "https://zhangfisher.github.io/flextree/",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/zhangfisher/flextree.git"
    },
    "license": "MIT",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "main": "dist/index.js",
        "module": "dist/index.js",
        "types": "dist/index.d.ts",
        "exports": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "keywords": [
        "flextree",
        "sql.js",
        "sqljs",
        "browser",
        "wasm",
        "tree storage"
    ],
    "main": "src/index.ts",
    "scripts": {
        "build": "tsup"
    },
    "devDependencies": {
        "@types/bun": "^1.1.6",
        "flextree": "^3.1.1",
        "sql.js": "^1.13.0",
        "tsup": "^8.1.0",
        "typescript": "^5.8.3"
    },
    "peerDependencies": {
        "flextree": "^3",
        "sql.js": "^1.10.0"
    }
}
